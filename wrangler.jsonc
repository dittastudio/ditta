{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Nitro merges this into the config it generates at .output/server/wrangler.json (main, assets and compatibility
  // flags come from there), which is what `wrangler deploy` and `wrangler preview` read.
  "name": "ditta",
  // Workers Logs (free plan: 200k events/day). Kept in config so deploys don't switch it off.
  "observability": { "enabled": true },
  // The live site is served only at ditta.studio (a Custom Domain on this Worker, with www redirected by a zone rule),
  // so ditta.ditta.workers.dev is off rather than serving a second copy of it.
  "workers_dev": false,
  // POST /api/brief: 3 briefs a minute per IP. Workers' rate limits only count over 10 or 60 seconds.
  "ratelimits": [{ "name": "BRIEF_RATE_LIMIT", "namespace_id": "1001", "simple": { "limit": 3, "period": 60 } }],
  // Sent briefs, pending until their email link is clicked (server/utils/briefs.ts). Migrations are applied with
  // `npx wrangler d1 migrations apply ditta-briefs --remote`; `--local` for `nuxt dev`.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ditta-briefs",
      "database_id": "110922d0-97f3-4a7f-94bc-432d06af3510",
      "migrations_dir": "server/database/migrations",
    },
  ],
  // Confirmed briefs' PDFs, as briefs/{id}.pdf (server/utils/briefPdf.ts)
  "r2_buckets": [{ "binding": "BRIEF_PDFS", "bucket_name": "ditta-briefs" }],
  // Hourly: runs the Nitro task in server/tasks/brief/sweep.ts, which nuxt.config.ts's scheduledTasks ties to this
  // same cron. Nitro runs the tasks but doesn't write the trigger, so it's here. Production only.
  "triggers": { "crons": ["0 * * * *"] },
  // Branch previews (<branch>-ditta.<subdomain>.workers.dev) stay on. `develop` is the Storyblok Visual Editor's
  // preview URL.
  "preview_urls": true,
  // Production (`main`): prerendered, published content. Its token is baked in at build from the
  // NUXT_STORYBLOK_TOKEN build variable (the public token), so no runtime secret is needed.
  "vars": {
    "NUXT_PUBLIC_STORYBLOK_VERSION": "published",
    // The brief builder's team email (server/api/brief/index.post.ts). Not secret, so kept here, where a deploy can't
    // drop it.
    "NUXT_BRIEF_FROM": "ditta briefs <briefs@ditta.studio>",
    "NUXT_BRIEF_TO": "hello@ditta.studio",
    // Browser Run renders the brief PDF through the account's API. Not secret; the token is.
    "NUXT_CLOUDFLARE_ACCOUNT_ID": "b2b14f73295e95bc6d2dad0a36c22414",
  },
  // Worker Previews (non-production branches): SPA, draft content + Visual Editor. Nothing is inherited from the top
  // level, so vars are repeated here. Set the preview token in the dashboard (Settings → Runtime variables and
  // secrets → Previews Base) or with `npx wrangler preview base-config secret put NUXT_PUBLIC_STORYBLOK_ACCESS_TOKEN`.
  "previews": {
    "vars": {
      "NUXT_PUBLIC_STORYBLOK_VERSION": "draft",
      "NUXT_BRIEF_FROM": "ditta briefs <briefs@ditta.studio>",
      "NUXT_BRIEF_TO": "hello@ditta.studio",
      "NUXT_CLOUDFLARE_ACCOUNT_ID": "b2b14f73295e95bc6d2dad0a36c22414",
    },
    // Their own database, so test briefs never sit among real ones
    "d1_databases": [
      {
        "binding": "DB",
        "database_name": "ditta-briefs-preview",
        "database_id": "8bab36c8-c6e5-4ab6-80a1-27eebca10980",
        "migrations_dir": "server/database/migrations",
      },
    ],
    // And their own bucket for PDFs
    "r2_buckets": [{ "binding": "BRIEF_PDFS", "bucket_name": "ditta-briefs-preview" }],
  },
}
