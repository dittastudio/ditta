{
  "name": "ditta",
  "private": true,
  "type": "module",
  "scripts": {
    "sb:schema-init": "storyblok schema init --space 284609",
    "sb:schema-validate": "storyblok schema validate .storyblok/schema/schema.ts",
    "sb:schema-diff": "storyblok schema push .storyblok/schema/schema.ts --space 284609 --dry-run",
    "sb:schema-push": "storyblok schema push .storyblok/schema/schema.ts --space 284609 --no-write-components",
    "sb:schema-rollback": "storyblok schema rollback --space 284609",
    "sb:migrations-generate": "storyblok migrations generate --space 284609",
    "sb:migrations-dry": "storyblok migrations run --space 284609 --dry-run",
    "sb:migrations-run": "storyblok migrations run --space 284609",
    "sb:migrations-rollback": "storyblok migrations rollback --space 284609",
    "sb:login": "storyblok login",
    "sb:logout": "storyblok logout",
    "sb:help": "storyblok --help",
    "create:icons": "npx nuxt-seo-utils icons --source ./favicon.svg",
    "agent:readability": "npx @vercel/agent-readability audit https://ditta.studio",
    "agent:isAgentic": "npx is-agentic ditta.studio",
    "dev": "nuxt dev --host 0.0.0.0",
    "dev:ssl": "local-ssl-proxy --source 3010 --target 3000 --cert localhost.pem --key localhost-key.pem",
    "build": "nuxt build",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "nuke": "del-cli '.output' 'dist' '.nuxt' 'node_modules' 'package-lock.json'",
    "prepare": "vp config && husky"
  },
  "dependencies": {
    "@mux/mux-video": "^0.31.3",
    "@nuxt/image": "^2.1.0",
    "@nuxtjs/plausible": "^4.0.0",
    "@pinia/nuxt": "^1.0.2",
    "@resvg/resvg-js": "^2.6.2",
    "@storyblok/nuxt": "^11.2.0",
    "@web-kits/audio": "^0.2.0",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "matter-js": "^0.20.0",
    "nuxt": "^4.5.2",
    "pinia-plugin-persistedstate": "^4.7.1",
    "satori": "^0.33.4",
    "vue": "^3.5.42",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@nuxtjs/seo": "^5.3.16",
    "@storyblok/schema": "^0.4.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/matter-js": "^0.20.2",
    "better-sqlite3": "^13.0.3",
    "del-cli": "^7.0.0",
    "husky": "^9.1.7",
    "nuxt-ai-ready": "^2.3.3",
    "postcss-nested": "^8.0.1",
    "postcss-utopia": "^1.1.0",
    "rolldown": "^1.2.8",
    "storyblok": "^4.22.4",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite-plus": "^0.3.2",
    "vite-svg-loader": "^5.1.3"
  }
}
