{
  "name": "ditta",
  "private": true,
  "type": "module",
  "scripts": {
    "sb:login": "storyblok login",
    "sb:logout": "storyblok logout",
    "sb:help": "storyblok --help",
    "sb:components": "storyblok components pull --space 284609 --verbose",
    "sb:types": "storyblok types generate --space 284609 --strict",
    "sb:generate": "npm run sb:components && npm run sb:types",
    "create:icons": "npx nuxt-seo-utils icons --source ./favicon.svg",
    "agent:readability": "npx @vercel/agent-readability audit https://ditta.studio",
    "dev": "npm run sb:generate && nuxt dev --host 0.0.0.0",
    "dev:ssl": "local-ssl-proxy --source 3010 --target 3000 --cert localhost.pem --key localhost-key.pem",
    "build": "nuxt build",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "nuke": "del-cli '.output' 'dist' '.nuxt' 'node_modules' 'package-lock.json'",
    "prepare": "vp config && husky"
  },
  "dependencies": {
    "@mux/mux-video": "^0.31.2",
    "@nuxt/image": "^2.1.0",
    "@nuxtjs/plausible": "^4.0.0",
    "@pinia/nuxt": "^1.0.2",
    "@resvg/resvg-js": "^2.6.2",
    "@storyblok/nuxt": "^11.1.3",
    "@web-kits/audio": "^0.1.0",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "matter-js": "^0.20.0",
    "nuxt": "^4.5.2",
    "pinia-plugin-persistedstate": "^4.7.1",
    "satori": "^0.29.0",
    "vue": "^3.5.41",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@nuxtjs/seo": "^5.3.12",
    "@tailwindcss/vite": "^4.3.3",
    "@types/matter-js": "^0.20.2",
    "better-sqlite3": "^13.0.3",
    "del-cli": "^7.0.0",
    "husky": "^9.1.7",
    "nuxt-ai-ready": "^1.7.12",
    "postcss-nested": "^8.0.1",
    "postcss-utopia": "^1.1.0",
    "rolldown": "^1.2.4",
    "storyblok": "^4.22.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite-plus": "^0.2.9",
    "vite-svg-loader": "^5.1.1"
  }
}
